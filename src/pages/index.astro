---
import Base from "../layouts/Base.astro";
import Grid from "../components/Grid.astro";
import Install from "../components/Install.astro";
import StarCta from "../components/StarCta.astro";
import Tile from "../components/Tile.astro";
import Terminal from "../components/Terminal.astro";
import { CATEGORIES, REPO, skills, installAll, installOne } from "../data/skills.js";

const count = (id) => skills.filter((s) => s.category === id).length;
// En la portada, la terminal reemplaza a los medios y como mucho van 3 láminas; el resto vive en la página de la skill.
const tiles = (s) => (s.terminal ? [] : (s.media ?? []).slice(0, 3));
---

<Base title="jato · skills" description="Skills para Claude Code y Codex: video y contenido, con ejemplos reales de lo que hacen.">
  <header class="mx-auto flex max-w-6xl items-center justify-between px-4 py-6 sm:px-8">
    <a href="https://jato.run" class="group flex items-baseline gap-0.5" aria-label="jato.run">
      <span class="text-2xl font-semibold tracking-tight">jato</span>
      <span class="font-mono text-sm text-dim transition-colors group-hover:text-muted">/skills</span>
    </a>
    <nav class="flex items-center gap-5 font-mono text-xs uppercase tracking-widest text-muted">
      <a href={REPO} target="_blank" rel="noopener" class="text-cyan hover:text-fg">★ <span class="hidden sm:inline">Estrella en </span>GitHub</a>
    </nav>
  </header>

  <main>
    <section class="relative isolate flex min-h-[62dvh] flex-col items-center justify-center px-4 text-center sm:px-8">
      <Grid />
      <h1 class="rise text-5xl font-semibold leading-[0.95] tracking-tighter sm:text-7xl md:text-8xl">
        Skills <span class="grad">para agentes.</span>
      </h1>
      <p class="rise mt-6 max-w-lg text-base text-muted sm:text-lg" style="animation-delay: 120ms">
        Pídelo en una frase. Claude Code o Codex hacen el resto.
      </p>
      <div class="rise mt-9 flex w-full max-w-xl items-stretch border border-line bg-panel/80 font-mono text-sm backdrop-blur" style="animation-delay: 200ms">
        <code class="flex-1 truncate px-4 py-3 text-left text-fg"><span class="text-cyan">$</span> {installAll}</code>
        <button data-copy={installAll} class="copy border-l border-line px-4 text-xs uppercase tracking-widest text-muted transition hover:bg-fg hover:text-ink">
          Copiar
        </button>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-8">
      <div class="mb-8 flex flex-wrap gap-2 font-mono text-xs uppercase tracking-widest" role="tablist">
        <button class="filter is-on border border-line px-3 py-2" data-filter="all">Todas <span class="text-dim">{skills.length}</span></button>
        {
          CATEGORIES.map((c) => (
            <button class="filter border border-line px-3 py-2" data-filter={c.id}>
              {c.label} <span class="text-dim">{count(c.id)}</span>
            </button>
          ))
        }
      </div>

      <div class="space-y-6">
        {
          skills.map((s) => (
            <article class="skill grid border border-line bg-panel lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]" data-category={s.category}>
              <div class="flex flex-col p-6 sm:p-8">
                <p class="font-mono text-xs text-dim">{s.name}</p>
                <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
                  <a href={`/${s.name}/`} class="hover:text-cyan">{s.title}</a>
                </h2>
                <p class="mt-3 leading-relaxed text-muted">{s.line}</p>

                <p class="mt-6 font-mono text-[11px] uppercase tracking-widest text-dim">Pídele</p>
                <p class="mt-2 border-l-2 border-cyan pl-3 text-fg">«{s.ask}»</p>

                <p class="mt-6 flex flex-wrap gap-1.5 font-mono text-[11px] text-muted">
                  {s.tools.map((t) => <span class="border border-line px-2 py-1">{t}</span>)}
                </p>

                <div class="mt-auto pt-8">
                  <div class="mb-2 flex items-baseline justify-between font-mono text-[11px] uppercase tracking-widest text-dim">
                    <span>Instalar solo esta</span>
                    <a href={`/${s.name}/`} class="normal-case tracking-normal text-muted hover:text-fg">Ver la skill →</a>
                  </div>
                  <Install cmd={installOne(s)} />
                </div>
              </div>

              <a
                href={`/${s.name}/`}
                aria-label={`Ver ${s.title}`}
                class="tiles flex items-center justify-center gap-3 overflow-hidden border-t border-line bg-ink p-4 sm:p-6 lg:border-l lg:border-t-0"
              >
                {tiles(s).map((m) => <Tile m={m} title={s.title} />)}
                {s.terminal && <Terminal lines={s.terminal} />}
              </a>
            </article>
          ))
        }
      </div>
    </section>
    <div class="mx-auto max-w-6xl px-4 sm:px-8"><StarCta /></div>
  </main>

  <footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 border-t border-line px-4 py-8 font-mono text-xs text-dim sm:px-8">
    <span>Un taller de <a href="https://jaimeaza.tech" target="_blank" rel="noopener author" class="text-muted hover:text-fg">Jaime Aza ↗</a></span>
    <a href="https://jato.run" class="hover:text-fg">jato.run</a>
  </footer>

  <style>
    .filter { color: var(--color-muted); transition: background 0.15s, color 0.15s; }
    .filter:hover { color: var(--color-fg); }
    .filter.is-on { background: var(--color-fg); color: var(--color-ink); border-color: var(--color-fg); }
    .filter.is-on span { color: var(--color-dim); }
  </style>

  <script>
    import "../scripts/copy.ts";
    import "../scripts/lazy-video.ts";

    // Filtro por categoría.
    const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
    const cards = document.querySelectorAll<HTMLElement>(".skill");
    for (const f of filters) {
      f.addEventListener("click", () => {
        filters.forEach((x) => x.classList.toggle("is-on", x === f));
        const id = f.dataset.filter;
        cards.forEach((c) => (c.hidden = id !== "all" && c.dataset.category !== id));
      });
    }
  </script>
</Base>
